# Database
DATABASE_URL=postgresql://astra:astra_password@postgres:5432/astra_db

# Redis
REDIS_URL=redis://redis:6379/0

# SMTP Configuration (for email sending)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=your-email@gmail.com

# LLM Provider (local or krutrim)
LLM_PROVIDER=local
# KRUTRIM_API_KEY=your-krutrim-api-key-here
# KRUTRIM_API_URL=https://api.krutrim.ai/v1

# Local LLM Configuration
LOCAL_LLM_MODEL=llama2
LOCAL_LLM_URL=http://localhost:11434  # Ollama default

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
DEBUG=true

# Security
SECRET_KEY=your-secret-key-change-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

# STT Configuration
STT_MODEL=whisper
WHISPER_MODEL_SIZE=base  # tiny, base, small, medium, large

# TTS Configuration
TTS_ENGINE=coqui  # or system
